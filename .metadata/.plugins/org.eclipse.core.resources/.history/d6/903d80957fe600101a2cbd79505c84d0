<%@ page contentType="text/html; charset=UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>

<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>Đổi mật khẩu</title>
<link rel="stylesheet"
	href="${pageContext.request.contextPath}/assets/css/style.css">
<style type="text/css">
.profile-container {
	max-width: 420px;
	margin: 60px auto;
	padding: 30px;
	background: #ffffff;
	border: 1px solid #e0e0e0;
	border-radius: 6px;
}

.profile-container h2 {
	text-align: center;
	margin-bottom: 25px;
	font-size: 22px;
	color: #333;
}

.profile-container input {
	width: 100%;
	padding: 12px;
	margin-bottom: 15px;
	border: 1px solid #ccc;
	border-radius: 4px;
	font-size: 14px;
}

.profile-container input:focus {
	outline: none;
	border-color: #007bff;
}

.profile-container .btn {
	width: 100%;
	padding: 12px;
	background-color: #007bff;
	color: #fff;
	border: none;
	border-radius: 4px;
	font-size: 15px;
	font-weight: 500;
	cursor: pointer;
}

.profile-container .btn:hover {
	background-color: #0056b3;
}

.profile-container p {
	margin-bottom: 15px;
	font-size: 14px;
	text-align: center;
}

/* Error & success */
.profile-container p[style*="red"] {
	color: #d93025;
}

.profile-container p[style*="green"] {
	color: #188038;
}
</style>
</head>

<body>
	<jsp:include page="/user-pages/navbar.jsp" />

	<div class="profile-container">
		<h2>🔑 Đổi mật khẩu</h2>

		<c:if test="${not empty error}">
			<p style="color: red">${error}</p>
		</c:if>

		<c:if test="${not empty success}">
			<p style="color: green">${success}</p>
		</c:if>

		<form action="${pageContext.request.contextPath}/change-password"
			method="post">
			<input type="password" name="oldPassword"
				placeholder="Mật khẩu hiện tại" required> <input
				type="password" name="newPassword" placeholder="Mật khẩu mới"
				required> <input type="password" name="confirmPassword"
				placeholder="Xác nhận mật khẩu mới" required>

			<button type="submit" class="btn">Cập nhật</button>
		</form>
	</div>

	<jsp:include page="/user-pages/footer.jsp" />
</body>
</html>
