<%@ page contentType="text/html; charset=UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>

<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>Thông tin cá nhân</title>
<link rel="stylesheet"
	href="${pageContext.request.contextPath}/assets/css/style.css">
<style type="text/css">/* ===== PROFILE PAGE ===== */
.profile-container {
	max-width: 480px;
	margin: 80px auto;
	padding: 100px 28px;
	background: #ffffff;
	border-radius: 14px;
	box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
	text-align: center;
}

.profile-container h2 {
	margin-bottom: 25px;
	font-size: 22px;
	color: #333;
}

.profile-item {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 14px 16px;
	margin-bottom: 12px;
	background: #f7f7f7;
	border-radius: 8px;
	font-size: 15px;
	color: #444;
}

.profile-item strong {
	color: #222;
}

.profile-container .btn {
	display: inline-block;
	margin-top: 22px;
	padding: 12px 26px;
	background: #111;
	color: #fff;
	text-decoration: none;
	border-radius: 8px;
	font-size: 14px;
	transition: 0.25s ease;
}

.profile-container .btn:hover {
	background: #333;
}
}
</style>
</head>

<body>
	<jsp:include page="/user-pages/navbar.jsp" />
	<div class="profile-container">
		<h2>👤 Thông tin cá nhân</h2>

		<div class="profile-item">
			<strong>Họ tên:</strong> ${sessionScope.user.username}
		</div>

		<div class="profile-item">
			<strong>Email:</strong> ${sessionScope.user.email}
		</div>

		<a class="btn" href="${pageContext.request.contextPath}/home"> ←
			Quay lại trang chủ </a>
	</div>
	<jsp:include page="/user-pages/footer.jsp" />
</body>
</html>
